<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CertifiedStaff</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CertifiedStaff.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="bg-white shadow-sm border-bottom">
        <div class="container-fluid px-4 py-3">
            <div class="d-flex align-items-center">
                <a href="#" class="text-decoration-none">
                    <img
                        src="https://flex.com/wp-content/themes/flex-parent/images/logo.svg"
                        alt="Flex"
                        style="height: 42px;">
                </a>

                <div class="ms-3">
                    <h1 class="h4 fw-bold mb-0">
                        <span style="color: #0198DD;">Flex</span>
                        Certifications Practice
                    </h1>
                    <small class="text-secondary">
                        Training & Certification Management
                    </small>
                </div>
            </div>
        </div>
    </header>
    <div class="container-fluid py-4">
        @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
