@page
@model IndexModel

<style>
    .pagination {
        margin-top: 8px;
        justify-content: flex-end;
    }

    .pagination .page-item .page-link {
        color: #2a2a2a;
        border: 1px solid #0198DD;
        font-size: 0.85rem;
        padding: 4px 10px;
        transition: all 0.2s ease-in-out;
    }

    .pagination .page-item .page-link:hover {
        background-color: #0198DD;
        color: #fff;
        border-color: #0198DD;
        transform: translateY(-1px);
    }

    .pagination .page-item.active .page-link {
        background-color: #2a2a2a;
        border-color: #2a2a2a;
        color: #fff;
    }

    .pagination .page-item.active .page-link:hover {
        background-color: #1f1f1f;
        border-color: #1f1f1f;
    }

    #filterForm {
        display: flex;
        flex-direction: column;
        gap: 8px; /* 4px arriba + 4px abajo entre elementos */
    }

    .cert-table {
        border: 1px solid #d8e7f0;
        border-radius: 10px;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .cert-table thead {
        background: #f7fafc;
    }

    .cert-table thead th {
        font-size: .85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #5c6770;
        border-bottom: 2px solid #0198DD;
        padding: 14px 12px;
        white-space: nowrap;
    }

    .cert-table tbody td {
        padding: 14px 12px;
        vertical-align: middle;
        border-color: #eef2f5;
    }

    .cert-table tbody tr {
        transition: all .15s ease-in-out;
    }

    .cert-table tbody tr:hover {
        background-color: #f8fbfd;
    }

    .cert-table tbody tr:last-child td {
        border-bottom: none;
    }

    .training-badge {
        background: rgba(1,152,221,.12);
        color: #0198DD;
        padding: 4px 10px;
        border-radius: 999px;
        font-weight: 600;
        font-size: .85rem;
    }
</style>

<div class="d-flex gap-4 align-items-start">

    <aside style="width: 320px;">
        <div class="card shadow-sm border-0 sticky-top">
            <div class="card-body d-flex flex-column gap-3">

                <div class="border-bottom pb-2 mb-1">
                    <h5 class="mb-0 fw-semibold">Certification Filters</h5>
                    <small class="text-muted">Filter employees by line, station, shift and supervisor.</small>
                </div>
                <form method="get" asp-page="Index" id="filterForm">

                    <select class="form-select" asp-for="ProductionLineId" asp-items="Model.ProductionLines"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a line</option>
                    </select>

                    <select class="form-select" asp-for="StationId" asp-items="Model.Stations"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a station</option>
                    </select>

                    <select class="form-select" asp-for="ShiftId" asp-items="Model.Shifts"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a shift</option>
                    </select>

                    <select class="form-select" asp-for="SupervisorId" asp-items="Model.Supervisors"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a supervisor</option>
                    </select>

                </form>

                <a asp-page-handler="ExportExcel"
                asp-route-ProductionLineId="@Model.ProductionLineId"
                asp-route-StationId="@Model.StationId"
                asp-route-SupervisorId="@Model.SupervisorId"
                asp-route-ShiftId="@Model.ShiftId"
                class="btn btn-dark w-100">
                    Export all as Excel
                </a>

            </div>
        </div>
    </aside>

    <!-- Content -->
    <main role="main" class="flex-grow-1">
        <div class="w-100 d-flex justify-content-end mt-2 mb-4">
            <a href="/certificates/new">
                <button
                    class="btn px-4"
                    style="background-color: #0198DD; color: #ffffff; border-radius: 8px;">
                    Add certificate
                </button>
            </a>
        </div>

        <!-- Ongoing -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Ongoing Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.OngoingTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.OngoingPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@i" asp-route-completedPage="@Model.CompletedPage"
                               asp-route-expiredPage="@Model.ExpiredPage">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>

            <table class="table cert-table mb-0">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Training %</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OngoingCertificates)
                    {
                        <tr>
                            <td>
                                <a asp-page="/employees/info"
                                asp-route-id="@item.EmployeeId"
                                class="btn btn-sm"
                                style="background-color:#0198DD;color:white;border-radius:8px;"
                                >
                                @item.Employee
                                </a>
                            </td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>
                                <span class="training-badge">
                                    @item.TrainingPercentage%
                                </span>
                            </td>
                            <td>
                                <a asp-page="/certificates/update"
                                asp-route-id="@item.CertificationId"
                                class="btn btn-sm"
                                style="background-color:#0198DD;color:white;border-radius:8px;">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Completed -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Completed Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.CompletedTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.CompletedPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@Model.OngoingPage" asp-route-completedPage="@i"
                               asp-route-expiredPage="@Model.ExpiredPage">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>

            <table class="table cert-table mb-0">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompletedCertificates)
                    {
                        <tr>
                            <td>
                                <a asp-page="/employees/info"
                                asp-route-id="@item.EmployeeId"
                                class="btn btn-sm"
                                style="background-color:#0198DD;color:white;border-radius:8px;"
                                >
                                @item.Employee
                                </a>
                            </td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Expired -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Expired Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.ExpiredTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.ExpiredPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@Model.OngoingPage"
                               asp-route-completedPage="@Model.CompletedPage" asp-route-expiredPage="@i">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>
            <table class="table cert-table mb-0">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExpiredCertificates)
                    {
                        <tr>
                            <td>
                                <a asp-page="/employees/info"
                                asp-route-id="@item.EmployeeId"
                                class="btn btn-sm"
                                style="background-color:#0198DD;color:white;border-radius:8px;"
                                >
                                @item.Employee
                                </a>
                            </td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </main>
