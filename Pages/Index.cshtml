@page
@model IndexModel

<div class="d-flex gap-4 align-items-start">

    <aside style="width: 320px;">
        <div class="card shadow-sm border-0 sticky-top">
            <div class="card-body d-flex flex-column gap-3">

                <div class="border-bottom pb-2 mb-1">
                    <h5 class="mb-0 fw-semibold">Certification Filters</h5>
                    <small class="text-muted">Filter employees by line, station, supervisor, and status</small>
                </div>

                <select class="form-select" asp-items="Model.ProductionLines">
                    <option selected>Select a line</option>
                </select>

                <select class="form-select" asp-items="Model.Stations">
                    <option selected>Select a station</option>
                </select>

                <select class="form-select" asp-items="Model.Supervisors">
                    <option selected>Select a supervisor</option>
                </select>

                <select class="form-select">
                    <option selected>Select a status</option>
                    <option>Ongoing</option>
                    <option>Completed</option>
                    <option>Expired</option>
                </select>

            </div>
        </div>
    </aside>

    <!-- Content -->
    <main role="main" class="flex-grow-1">

        <!-- Ongoing -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Ongoing Certificates
            </h5>

            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Training %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OngoingCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.TrainingPercentage%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Completed -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Completed Certificates
            </h5>

            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Training %</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompletedCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.TrainingPercentage%</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Expired -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Expired Certificates
            </h5>

            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Training %</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExpiredCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.TrainingPercentage%</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </main>
