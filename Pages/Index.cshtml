@page
@model IndexModel

<style>
    .pagination {
        margin-top: 8px;
        justify-content: flex-end;
    }

    .pagination .page-item .page-link {
        color: #2a2a2a;
        border: 1px solid #2596be;
        font-size: 0.85rem;
        padding: 4px 10px;
        transition: all 0.2s ease-in-out;
    }

    .pagination .page-item .page-link:hover {
        background-color: #2596be;
        color: #fff;
        border-color: #2596be;
        transform: translateY(-1px);
    }

    .pagination .page-item.active .page-link {
        background-color: #2a2a2a;
        border-color: #2a2a2a;
        color: #fff;
    }

    .pagination .page-item.active .page-link:hover {
        background-color: #1f1f1f;
        border-color: #1f1f1f;
    }

    #filterForm {
        display: flex;
        flex-direction: column;
        gap: 8px; /* 4px arriba + 4px abajo entre elementos */
    }
</style>

<div class="d-flex gap-4 align-items-start">

    <aside style="width: 320px;">
        <div class="card shadow-sm border-0 sticky-top">
            <div class="card-body d-flex flex-column gap-3">

                <div class="border-bottom pb-2 mb-1">
                    <h5 class="mb-0 fw-semibold">Certification Filters</h5>
                    <small class="text-muted">Filter employees by line, station and supervisor.</small>
                </div>
                <form method="get" asp-page="Index" id="filterForm">

                    <select class="form-select" asp-for="ProductionLineId" asp-items="Model.ProductionLines"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a line</option>
                    </select>

                    <select class="form-select" asp-for="StationId" asp-items="Model.Stations"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a station</option>
                    </select>

                    <select class="form-select" asp-for="SupervisorId" asp-items="Model.Supervisors"
                            onchange="document.getElementById('filterForm').submit()">
                        <option value="">Select a supervisor</option>
                    </select>

                </form>

                <a asp-page-handler="ExportExcel"
                class="btn btn-dark w-100">
                    Export all as Excel
                </a>

            </div>
        </div>
    </aside>

    <!-- Content -->
    <main role="main" class="flex-grow-1">

        <!-- Ongoing -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Ongoing Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.OngoingTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.OngoingPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@i" asp-route-completedPage="@Model.CompletedPage"
                               asp-route-expiredPage="@Model.ExpiredPage">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>

            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a; border-radius: 6px;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Training %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OngoingCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.TrainingPercentage%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Completed -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Completed Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.CompletedTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.CompletedPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@Model.OngoingPage" asp-route-completedPage="@i"
                               asp-route-expiredPage="@Model.ExpiredPage">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>

            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a; border-radius: 6px;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompletedCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Expired -->
        <div class="mb-4">
            <h5 class="p-2 mb-0 text-white" style="background-color:#2a2a2a;">
                Expired Certificates
            </h5>
            <nav>
                <ul class="pagination">

                    @for (int i = 1; i <= Math.Ceiling(Model.ExpiredTotal / (double)Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.ExpiredPage ? "active" : "")">
                            <a class="page-link" asp-route-ongoingPage="@Model.OngoingPage"
                               asp-route-completedPage="@Model.CompletedPage" asp-route-expiredPage="@i">
                                @i
                            </a>
                        </li>
                    }

                </ul>
            </nav>
            <table class="table table-sm" style="border:1px solid #2596be; color:#2a2a2a; border-radius: 6px;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Shift</th>
                        <th>Production Line / Station</th>
                        <th>Certification Date</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExpiredCertificates)
                    {
                        <tr>
                            <td>@item.Employee</td>
                            <td>@item.Supervisor</td>
                            <td>@item.Shift</td>
                            <td>@item.ProductionLineStation</td>
                            <td>@item.CertificationDate</td>
                            <td>@item.ExpirationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </main>
