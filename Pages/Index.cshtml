@page
@model IndexModel

<div class="d-flex gap-4 align-items-start">

    <aside style="width: 320px;">
        <div class="card shadow-sm border-0 sticky-top">
            <div class="card-body d-flex flex-column gap-3">

                <div class="border-bottom pb-2 mb-1">
                    <h5 class="mb-0 fw-semibold">Certification Filters</h5>
                    <small class="text-muted">Filter employees by line, station, supervisor, and status</small>
                </div>

                <select class="form-select" asp-items="Model.ProductionLines">
                    <option selected>Select a line</option>
                </select>

                <select class="form-select" asp-items="Model.Stations">
                    <option selected>Select a station</option>
                </select>

                <select class="form-select" asp-items="Model.Supervisors">
                    <option selected>Select a supervisor</option>
                </select>

                <select class="form-select">
                    <option selected>Select a status</option>
                    <option>Ongoing</option>
                    <option>Completed</option>
                    <option>Expired</option>
                </select>

            </div>
        </div>
    </aside>

    <!-- Content -->
    <main role="main" class="flex-grow-1">
    </main>
