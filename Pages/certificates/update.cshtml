@page
@model UpdateCertificationModel


<style>
    #certificateForm {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-card {
        max-width: 700px;
        margin: 0 auto;
    }

    .form-label {
        font-weight: 500;
        color: #2a2a2a;
        margin-bottom: 4px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #0198DD;
        box-shadow: 0 0 0 .2rem rgba(1, 152, 221, .15);
    }
</style>

<div class="container py-4">

    <div class="form-card card shadow-sm border-0">

        <div class="card-header text-white"
             style="background-color:#2a2a2a;">
            <h5 class="mb-0">Update Certificate</h5>
        </div>

        <div class="card-body">

            <form method="post" id="certificateForm" asp-page-handler="UpdateCertificate">
                <input type="hidden"
                    asp-for="CertificationToUpdate.CertificateId" />

                <div>
                    <label class="form-label">
                        Production Line
                    </label>
                    <select class="form-select" asp-items="Model.ProductionLines" asp-for="CertificationToUpdate.ProductionLineId">
                        <option value="">Select a line</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">
                        Station
                    </label>
                    <select class="form-select" asp-items="Model.Stations" asp-for="CertificationToUpdate.StationId">
                        <option value="">Select a station</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">
                        Employee
                    </label>
                    <select class="form-select" asp-items="Model.Employees" asp-for="CertificationToUpdate.EmployeeId">
                        <option value="">Select an employee</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">
                        Training Percentage
                    </label>
                    <input
                           asp-for="CertificationToUpdate.TrainingPercentage"
                           type="number"
                           class="form-control"
                           min="0"
                           max="100"/>
                </div>

                <div class="d-flex justify-content-between pt-2">

                    <a asp-page="/Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn px-4"
                            style="background-color:#0198DD;color:#ffffff;border-radius:8px;">
                        Update data
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>
